# Each machine has a DHCP reservation on the home router (mDNS .local names
# don't cross the mesh Wi-Fi).
Host laptop
    HostName 192.168.1.23

Host workstation
    HostName 192.168.1.31

Host laptop workstation
    User seth

# Raspberry Pi (Debian, also the LAN's DNS server)
Host pi
    HostName 192.168.1.246
    User seth

# Termux on the phone: its sshd runs on 8022 and accepts any user name
Host phone
    HostName 192.168.1.9
    Port 8022

Host *
    # Host keys of my machines ship in known_hosts_home; ssh adds others to known_hosts
    UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts_home
    # Ask for a key's passphrase once, then keep it in the agent for the session
    AddKeysToAgent yes
