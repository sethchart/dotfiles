# Every machine is reached by its Tailscale name (MagicDNS), so the same
# names work at home and away. Each device must be signed in to the tailnet
# (`sudo tailscale up`; the Tailscale app on the phone).

# pi is the Raspberry Pi (Debian, also the LAN's DNS server)
Host laptop workstation pi
    HostName %h.tail9c4b52.ts.net
    User seth

# Termux on the phone: its sshd runs on 8022 and accepts any user name
Host phone
    HostName phone.tail9c4b52.ts.net
    Port 8022

Host *
    # Host keys of my machines ship in known_hosts_home; ssh adds others to known_hosts
    UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/known_hosts_home
    # Ask for a key's passphrase once, then keep it in the agent for the session
    AddKeysToAgent yes
