[Unit]
Description=Miniflux database (PostgreSQL)

[Container]
ContainerName=miniflux-db
# A major version bump needs a dump and restore; minor updates are automatic.
Image=docker.io/library/postgres:17-alpine
AutoUpdate=registry
Pod=miniflux.pod
Volume=miniflux-db:/var/lib/postgresql/data
Environment=POSTGRES_USER=miniflux POSTGRES_DB=miniflux
# POSTGRES_PASSWORD; generated by run_onchange_after_user-miniflux.sh
EnvironmentFile=%h/.config/miniflux/db.env
HealthCmd=pg_isready -U miniflux
HealthInterval=10s
Notify=healthy

[Service]
Restart=on-failure
# The first start pulls the image.
TimeoutStartSec=900
