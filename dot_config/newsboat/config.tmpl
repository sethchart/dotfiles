# Feeds, read state and stars live in Miniflux on the workstation; newsboat
# is a terminal front end to it. The password comes from the login keyring
# (stored there by run_onchange_after_user-miniflux.sh on the workstation; on
# other machines: secret-tool store --label=Miniflux service miniflux user {{ .miniflux.user }}).
urls-source "miniflux"
{{- if .miniflux.url }}
miniflux-url "{{ .miniflux.url }}"
{{- else }}
# Set miniflux.url in .chezmoidata/miniflux.yaml to use this off the workstation.
miniflux-url "http://127.0.0.1:8080/"
{{- end }}
miniflux-login "{{ .miniflux.user }}"
miniflux-passwordeval "secret-tool lookup service miniflux user {{ .miniflux.user }}"

reload-time 30
auto-reload yes
show-read-feeds no
browser "xdg-open %u"
# Videos and podcast enclosures: open with mpv
macro v set browser "mpv %u" ; open-in-browser ; set browser "xdg-open %u"
