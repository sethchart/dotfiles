#!/bin/bash
# System settings outside the home directory (needs sudo).
# chezmoi re-runs this whenever the rendered script changes.
set -euo pipefail

# Networking: iwd for Wi-Fi (impala is its TUI) with its built-in DHCP,
# systemd-networkd for wired, systemd-resolved for DNS. NetworkManager would
# fight iwd for the Wi-Fi card, so it is removed if present.
sudo mkdir -p /etc/iwd /etc/systemd/network
printf '[General]\nEnableNetworkConfiguration=true\n\n[Network]\nNameResolvingService=systemd\n' | sudo tee /etc/iwd/main.conf >/dev/null
# RequiredForOnline=no: an unplugged cable shouldn't stall boot in networkd-wait-online
printf '[Match]\nType=ether\n\n[Link]\nRequiredForOnline=no\n\n[Network]\nDHCP=yes\n' | sudo tee /etc/systemd/network/20-wired.network >/dev/null
if pacman -Q networkmanager &>/dev/null; then
  sudo systemctl disable --now NetworkManager.service NetworkManager-wait-online.service NetworkManager-dispatcher.service
  sudo pacman -Rns --noconfirm networkmanager
fi
sudo systemctl enable --now systemd-resolved.service systemd-networkd.service iwd.service
sudo ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

# Weekly SSD TRIM, and weekly pruning of the package cache to the last 3 versions
sudo systemctl enable --now fstrim.timer paccache.timer

# Power profiles (powerprofilesctl set power-saver|balanced|performance)
sudo systemctl enable --now power-profiles-daemon.service

# keyd: Super acts as Ctrl for copy/paste/cut/select-all/undo, Mac style.
# Per-app overrides live in ~/.config/keyd/app.conf (keyd-application-mapper,
# which needs the keyd group to reach the daemon's socket).
sudo mkdir -p /etc/keyd
printf '[ids]\n*\n\n[main]\nleftmeta = layer(meta)\n\n[meta:C]\nc = C-c\nv = C-v\nx = C-x\na = C-a\nz = C-z\n\n' | sudo tee /etc/keyd/default.conf >/dev/null
sudo systemctl enable --now keyd.service
sudo keyd reload
sudo usermod -aG keyd "$USER"
{{- if eq .chezmoi.hostname "laptop" }}

# Power button hibernates; closing the lid suspends, then hibernates after 2 hours
sudo mkdir -p /etc/systemd/logind.conf.d /etc/systemd/sleep.conf.d
printf '[Login]\nHandlePowerKey=hibernate\n' | sudo tee /etc/systemd/logind.conf.d/power-key.conf >/dev/null
printf '[Login]\nHandleLidSwitch=suspend-then-hibernate\n' | sudo tee /etc/systemd/logind.conf.d/lid.conf >/dev/null
printf '[Sleep]\nHibernateDelaySec=2h\n' | sudo tee /etc/systemd/sleep.conf.d/hibernate-delay.conf >/dev/null
# Reload logind's settings (a restart would end the session)
sudo systemctl kill -s HUP systemd-logind
{{- end }}
